# Compose configuration template: fill private values in an ignored .env file.
DB_NAME=fasswerk
DB_USER=replace_me
DB_PASSWORD=
JWT_SECRET=
# Optional first-admin provisioning. Supply BOTH or leave BOTH empty.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
QR_SCAN_BASE_URL=http://localhost:3000
# Production without Compose additionally requires:
# SPRING_PROFILES_ACTIVE=prod
# DB_URL=jdbc:postgresql://db.example.invalid:5432/fasswerk

# Exact public frontend origin for cookie-request CSRF checks (HTTPS in production).
APP_ORIGIN=http://localhost:3000

# Venue zone for reservation opening hours and business dates
RESERVATION_TIMEZONE=Europe/Berlin
