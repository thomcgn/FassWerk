# Database
DB_URL=jdbc:postgresql://localhost:5432/fasswerk
DB_USER=fasswerk
DB_PASSWORD=fasswerk

# Server
SERVER_PORT=8080

# QR links
QR_SCAN_BASE_URL=http://localhost:8080

# JWT
JWT_SECRET=change-me-super-long-jwt-secret-at-least-32-characters
JWT_ISSUER=fasswerk-backend
JWT_ACCESS_TOKEN_MINUTES=120
JWT_REFRESH_TOKEN_DAYS=14

# Auth cleanup scheduler
AUTH_CLEANUP_ENABLED=true
AUTH_CLEANUP_CRON="0 */30 * * * *"
AUTH_CLEANUP_REFRESH_TOKENS=true

