# Local development only. This file contains no usable secrets.
SPRING_PROFILES_ACTIVE=dev
# DB_URL/DB_USER/DB_PASSWORD may be omitted for the explicit dev profile defaults.
# Set these for a differently configured local database:
# DB_URL=jdbc:postgresql://localhost:5432/fasswerk
# DB_USER=replace_me
# DB_PASSWORD=replace_me
# JWT_SECRET may be omitted in dev; production requires a private random key.
# JWT_SECRET=replace_me
SERVER_PORT=8080
QR_SCAN_BASE_URL=http://localhost:3000
JWT_ISSUER=fasswerk-backend
JWT_ACCESS_TOKEN_MINUTES=120
JWT_REFRESH_TOKEN_DAYS=14
AUTH_CLEANUP_ENABLED=true
AUTH_CLEANUP_CRON='0 */30 * * * *'
AUTH_CLEANUP_REFRESH_TOKENS=true
# Optional first-admin provisioning. Set BOTH to private values; remove after setup.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
# BOOTSTRAP_ADMIN_PASSWORD=replace_me
RESERVATION_MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
RESERVATION_MAIL_FROM=no-reply@example.invalid
